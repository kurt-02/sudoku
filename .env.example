# Copy to .env.local and fill in values.

# Phase 4 — database (Postgres; Supabase in production)
# Supabase > Project > Connect. App: the "Transaction pooler" URI (port 6543).
DATABASE_URL=
# Migrations: the "Session pooler" URI (port 5432). Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# Phase 5 — Google auth (Auth.js)
# Generate with: npx auth secret
AUTH_SECRET=
# From Google Cloud > Google Auth Platform > Clients. Redirect URI:
#   http://localhost:3000/api/auth/callback/google (plus your production URL when deployed)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only for self-hosted production (`next start`); `next dev` and Vercel don't need it.
# AUTH_TRUST_HOST=true
